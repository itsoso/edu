# Default disabled. Confirm the existing Edu user and Health subject before enabling.
# Load these in the Edu service environment; never commit production values.
EDU_HEALTH_SSO_ENABLED=0
EDU_HEALTH_SSO_ISSUER=https://health.executor.life
EDU_HEALTH_SSO_ORIGIN=https://edu.executor.life
EDU_HEALTH_SSO_SUBJECT=
EDU_HEALTH_SSO_USER_ID=
# Dedicated shared secret, >=32 characters, identical to Health EDU_SSO_SECRET.
EDU_HEALTH_SSO_SECRET=

# Optional explicit Health subject -> read-only Edu parent mapping (synthetic example).
# Parent must remain bound to EDU_HEALTH_SSO_USER_ID. Defaults to no viewers.
EDU_HEALTH_SSO_VIEWERS={}
